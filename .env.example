# Required: wallet private key used to sign x402 USDC payments on Base.
# Generate with `zero init` (saved to ~/.zero/config.json), or import an existing
# key with `zero wallet set 0x...`. NEVER commit a real value. Rotate immediately
# if it leaks — anyone with this key can drain the wallet.
ZERO_PRIVATE_KEY=0x...

# Optional: per-call hard cap (USDC) enforced server-side regardless of frontend
# slider. Defaults to 0.50. Frontend slider is a soft cap; this is the floor.
ZERO_MAX_PAY_CEILING=0.50
