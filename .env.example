# Required: The private key for your Zero node wallet (hex format starting with 0x)
# This MUST be set before running the server or capability routing will fail.
ZERO_PRIVATE_KEY=your_private_key_here

# Optional: Server-side hard budget limit (cap) in USDC per individual request
# Defaults to 0.50 USDC if not explicitly specified.
ZERO_MAX_PAY_CEILING=0.50
